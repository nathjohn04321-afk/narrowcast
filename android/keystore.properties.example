# Copy to android/keystore.properties and fill in. That file is git-ignored.
# Alternatively set NARROWCAST_KEYSTORE / NARROWCAST_KEYSTORE_PASSWORD /
# NARROWCAST_KEY_ALIAS / NARROWCAST_KEY_PASSWORD in the environment and skip
# this file entirely, which keeps the password out of any file at all.

storeFile=/absolute/path/to/narrowcast.keystore
storePassword=
keyAlias=narrowcast
keyPassword=
